# Laisser vide pour le mode démo (données fictives, rien à installer).
# Pour brancher une vraie base Supabase, copier ce fichier en .env.local et remplir :
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Facultatif : lien d'installation de l'appli, ajouté au message d'accès envoyé aux clients.
EXPO_PUBLIC_LIEN_APPLI=
# Moyens de connexion en plus de l'e-mail et du mot de passe, une fois réglés dans Supabase :
# google, azure (Microsoft), apple (iPhone seulement), inscription (le client crée son compte lui-même).
EXPO_PUBLIC_CONNEXIONS=
