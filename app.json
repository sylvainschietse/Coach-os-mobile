{
  "expo": {
    "name": "CoachGo",
    "slug": "coach-os",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coachos",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.coachgo.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coachgo.app",
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CoachGo"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D71920"
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CoachGo utilise le micro pour dicter tes demandes, filmer tes mouvements avec le son et enregistrer les réponses vocales du coach.",
          "speechRecognitionPermission": "CoachGo transcrit ta voix pour remplir les demandes aux assistants.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-mail-composer",
      [
        "expo-camera",
        {
          "cameraPermission": "CoachGo utilise l’appareil photo pour scanner le code-barres de tes aliments, photographier tes repas et filmer tes mouvements pour ton coach.",
          "microphonePermission": "CoachGo utilise le micro pour dicter tes demandes, filmer tes mouvements avec le son et enregistrer les réponses vocales du coach.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CoachGo utilise le micro pour dicter tes demandes, filmer tes mouvements avec le son et enregistrer les réponses vocales du coach."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "CoachGo ouvre tes photos et vidéos pour estimer ce qu’il y a dans ton assiette ou envoyer un mouvement à ton coach.",
          "cameraPermission": "CoachGo utilise l’appareil photo pour photographier tes repas."
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "CoachGo lit tes entraînements (machines Technogym, montre, applis de sport) pour que ton coach suive tes séances et adapte ton programme.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
